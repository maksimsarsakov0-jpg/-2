  .walk-step-text { font-size: 10px; padding: 3px 8px; }
  .walk-steps .pano-nav { width: 30px; height: 30px; }
  .walk-minimap-panel { transform: scale(0.6); top: 6px; right: 6px; padding: 5px; }
  .walk-location { top: 6px; left: 6px; max-width: 45vw; min-width: 0; padding: 6px 8px; }
  .walk-location-title { font-size: 11px; }
  .walk-events { display: none; }
  .walk-guide { display: none; }
  .walk-footer { flex-wrap: wrap; gap: 6px; padding: 8px 10px; }
  .walk-footer .pano-route { max-width: 100%; font-size: 11px; white-space: normal; }
  .walk-footer .btn { font-size: 11px; padding: 6px 8px; }
  .pano-footer { flex-wrap: wrap; gap: 8px; padding: 8px 10px; }
  .pano-route { max-width: 100%; font-size: 11px; white-space: normal; }
  .pano-minimap-wrap { width: 150px; }
  #panoMiniCanvas { width: 150px; height: 100px; }
  .pano-tip { display: none; }
  .pano-events { display: none; }
}
.hidden { display: none !important; }
@media (max-width: 1080px) {
  .layout { grid-template-columns: 1fr; height: auto; }
  .sidebar { flex-direction: row; flex-wrap: wrap; }
  .panel { flex: 1 1 260px; }
}
